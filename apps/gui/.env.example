# GUI configuration. Copy to `.env` and edit. Every value below is optional -
# `moon run dev` starts a working GUI with none of them set.
#
#   cp apps/gui/.env.example apps/gui/.env
#
# Only variables prefixed `VITE_` reach the browser bundle (Vite's rule), and
# they are embedded into the built assets - never put a secret in this file.

# --- Auth --------------------------------------------------------------------
# "true" makes the app redirect to /login when there is no session. Left unset,
# login enforcement is off and the app renders for anonymous visitors, which is
# the current local-dev default. In a `vite dev` build the app also bootstraps a
# session through the backend's test-login endpoint, which requires
# ENABLE_TEST_LOGIN on the backend (see apps/backend/.env.example).
# VITE_REQUIRE_AUTH=false

# --- Repository linking ------------------------------------------------------
# OAuth consumer ids for the "Connect GitHub/Bitbucket via OAuth" buttons on the
# repository link form. Public client ids, not secrets. Neither is needed for
# Bitbucket's direct API-token path.
# VITE_GITHUB_CLIENT_ID=
# VITE_BITBUCKET_CLIENT_ID=
