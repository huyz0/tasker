# Backend configuration. Copy to `.env` and edit; every value below is
# optional for local development - `moon run dev` starts a working stack with
# none of them set. See apps/backend/README.md for the full table.
#
#   cp apps/backend/.env.example apps/backend/.env

# --- Storage -----------------------------------------------------------------
# "true" runs against an embedded SQLite file (no Docker, no MySQL). Anything
# else uses MySQL via the DB_* settings below. `moon run dev` sets this itself.
STANDALONE=true

# Only read when STANDALONE is not "true".
# DB_HOST=127.0.0.1
# DB_NAME=tasker
# DB_USER=root
# DB_PASSWORD=password
# DB_POOL_SIZE=20
# DB_POOL_QUEUE_LIMIT=200

# --- Local auth --------------------------------------------------------------
# Enables /api/auth/test/inject so the GUI can mint a dev session without
# completing real Google OAuth. `moon run dev` defaults this to true.
# The server REFUSES TO START with this enabled when NODE_ENV=production.
ENABLE_TEST_LOGIN=true

NODE_ENV=development

# --- Secrets -----------------------------------------------------------------
# Both have dev-only defaults and are REQUIRED in production, where the server
# refuses to start if they are still the defaults.
# JWT_SECRET=change_me
# APP_ENCRYPTION_SECRET must be exactly 32 bytes (AES-256-GCM).
# APP_ENCRYPTION_SECRET=00000000000000000000000000000000

# --- OAuth providers ---------------------------------------------------------
# Google sign-in for the GUI and `tasker auth login`. Not needed while
# ENABLE_TEST_LOGIN is on.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=

# Repository linking. The Bitbucket API-token path needs no consumer at all.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# BITBUCKET_CLIENT_ID=
# BITBUCKET_CLIENT_SECRET=

# --- Everything else ---------------------------------------------------------
# Browser origins allowed to send credentialed requests (allowlist, not mirror).
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Domain event bus. Unreachable is non-fatal: the backend logs and continues.
# NATS_URL=nats://localhost:4222

# LOG_LEVEL=info
