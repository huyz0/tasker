{
  "name": "backend",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "oxlint .",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:integration": "bun test src/modules/repositories/repositories.integration.test.ts",
    "test:integration-realtime": "bun test src/modules/events/realtime.integration.test.ts",
    "build:standalone": "bun run scripts/bundle-gui.ts && (bun build --compile --minify --sourcemap --outfile dist/tasker-standalone src/index.ts; ec=$?; bun run scripts/bundle-gui.ts --reset; exit $ec)",
    "bundle:gui": "bun run scripts/bundle-gui.ts",
    "generate:migrations": "bun run scripts/generate-embedded-migrations.ts",
    "seed": "STANDALONE=true bun run scripts/seed.ts",
    "measure:members": "STANDALONE=true bun run scripts/measure-members.ts",
    "measure:latency": "STANDALONE=true bun run scripts/measure-latency.ts",
    "migrate:roles": "bun run scripts/migrate-roles.ts"
  },
  "dependencies": {
    "pino": "^10.3.1",
    "shared-contract": "workspace:*"
  }
}
