# The single source of truth for toolchain versions. `.moon/toolchain.yml` used
# to duplicate these and had drifted years out of date (node 22.14.0, bun
# 1.0.30, go 1.22.0); moon 2 ignores its deprecated platform keys entirely -
# removing it changed no task's behaviour - so it is gone rather than kept in
# manual sync. Every project is `language: system`, so commands resolve through
# proto's shims and these pins are what actually run.
node = "24.12.0"
bun = "1.3.11"
# Pinned so a proto-managed moon resolves a version here. Without it, anything
# invoking `moon` through proto's shim - the pre-commit hook included - fails
# with "Failed to detect an applicable version to run moon with".
moon = "2.4.6"
# Must be >= the `go` directive in apps/cli/go.mod (1.26.1), which is the
# module's own minimum - a lower pin here means `moon setup` installs a
# toolchain the CLI refuses to build with.
go = "1.26.1"

[settings]
auto-install = true