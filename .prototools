node = "24.12.0"
bun = "1.3.11"
# Pinned so a proto-managed moon resolves a version here. Without it, anything
# invoking `moon` through proto's shim - the pre-commit hook included - fails
# with "Failed to detect an applicable version to run moon with".
moon = "2.4.6"
# Must be >= the `go` directive in apps/cli/go.mod (1.26.1), which is the
# module's own minimum - a lower pin here means `moon setup` installs a
# toolchain the CLI refuses to build with.
go = "1.26.1"

[settings]
auto-install = true